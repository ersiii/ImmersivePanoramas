{
  "schemaVersion": 1,
  "id": "immersivepanoramas",
  "version": "${version}",
  "name": "Immersive Panoramas",
  "description": "Seamlessly captures dynamic 360° panoramas when leaving worlds or servers and updates your main menu background.",
  "authors": ["Ersi"],
  "contact": {
    "homepage": "https://modrinth.com/mod/immersive-panoramas",
    "sources": "https://github.com/ersiii/ImmersivePanoramas",
    "issues": "https://github.com/ersiii/ImmersivePanoramas/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/immersivepanoramas/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "xyz.ersi.immersivepanoramas.client.ImmersivePanoramasClient"
    ],
    "modmenu": [
      "xyz.ersi.immersivepanoramas.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "immersivepanoramas.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
